# Time Tracking Demo — copy to `.env` for local / Compose overrides (optional).
# Never commit real secrets. This demo has no auth keys.

# --- API (NestJS) ---
# Listen port inside the process / container
PORT=3000

# SQLite file path
# Local (non-Docker): relative to process cwd or absolute
SQLITE_PATH=./apps/api/data/time-tracking-demo.sqlite
# Docker Compose sets SQLITE_PATH=/data/time-tracking-demo.sqlite
# (compose key sqlite_data → Docker name time_tracking_demo_sqlite_data → /data)

# Seed fictional employees on boot (faker). Set false to skip.
SEED_ON_BOOT=true

# Force purge + dense reseed on API boot (AC-17 / AC-30). Wipes departments,
# employees, time_entries then reloads chart/report-ready demo data.
# Compose: SEED_FORCE=1 docker compose up -d api   (then unset — volume keeps data)
# Caveat: named volume time_tracking_demo_sqlite_data survives `down` without `-v`;
# SEED_ON_BOOT alone will NOT replace existing rows. Full wipe: docker compose down -v
SEED_FORCE=false

# --- Host ports (documentation; Compose maps these in docker-compose.yml) ---
# API published:  3000 → container 3000
# UI  published:  8081 → container 80 (nginx). Prefer 8081 — leave :8080 for other stacks.

# --- Test helpers (not read by the app) ---
# API_BASE_URL=http://localhost:3000/api
# WEB_BASE_URL=http://localhost:8081
