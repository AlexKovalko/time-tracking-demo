# falconai — copy to `.env` for local / Compose overrides (optional).
# Never commit real secrets. This demo has no auth keys.

# --- API (NestJS) ---
# Listen port inside the process / container
PORT=3000

# SQLite file path
# Local (non-Docker): relative to process cwd or absolute
SQLITE_PATH=./apps/api/data/falconai.sqlite
# Docker Compose sets SQLITE_PATH=/data/falconai.sqlite
# (compose key sqlite_data → Docker name falconai_sqlite_data → /data)

# Seed fictional employees on boot (faker). Set false to skip.
SEED_ON_BOOT=true

# --- Host ports (documentation; Compose maps these in docker-compose.yml) ---
# API published:  3000 → container 3000
# UI  published:  8081 → container 80 (nginx). Prefer 8081 — host :8080 often busy.

# --- Test helpers (not read by the app) ---
# API_BASE_URL=http://localhost:3000/api
# WEB_BASE_URL=http://localhost:8081
